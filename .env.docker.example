# Copy these values into a root .env file on the server before running docker compose.
APP_NAME=Aventra
APP_ENV=production
APP_DEBUG=false

# Generate once and keep stable:
# docker run --rm php:8.2-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=

# Public URLs for your server.
APP_URL=http://your-server-ip:8000
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Leave empty when using the frontend container proxy.
# Set to http://your-server-ip:8000 if you want browser calls to hit the backend port directly.
BACKEND_PUBLIC_URL=
REACT_APP_API_URL=

DB_DATABASE=aventra
DB_USERNAME=aventra
DB_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root_me

CORS_ALLOWED_ORIGINS=http://your-server-ip:3000
SANCTUM_STATEFUL_DOMAINS=your-server-ip:3000

# Runs php artisan migrate --force when the backend starts.
RUN_MIGRATIONS=true
